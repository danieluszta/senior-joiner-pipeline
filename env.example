# Copy to .env — scripts/run.ts loads it explicitly, no shell sourcing needed.
# .env is gitignored. Never commit real values.

BLITZ_API_KEY=           # Blitz API key (people search, company/person enrich)
OPENAI_API_KEY=          # the gpt-5-nano judges (JUDGE_MODEL env overrides the model)
DATABASE_URL=            # optional: Supabase Postgres — omit for file-only runs
