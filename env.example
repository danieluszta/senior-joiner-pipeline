# Copy to .env (gitignored) and load it (e.g. `set -a; source .env; set +a`).
# Never commit real values.

# Your people-data provider key — used by pipeline/provider.py once you wire it
PROVIDER_API_KEY=

# LLM gates (steps 3 and 4, LLM flavor only). Any OpenAI-compatible API.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
